import React from 'react';
import { View, Text, StyleSheet, Image, Button, TouchableOpacity, FlatList } from 'react-native';

const Cart = () => {
  const todayItems = [
    { id: 1, name: "Burger & Fries", price: 200, time: "4:00pm", image: require("./burger.jpg"), quantity: 1 },
    { id: 2, name: "Jollof rice & chicken", price: 150, time: "4:00pm", image: require("./jollof.jpg"), quantity: 1 },
  ];

  const lastWeekItems = [
    { id: 3, name: "Water melon", price: 30, time: "4:00pm", image: require("./watermelon.jpg"), quantity: 1 },
    { id: 4, name: "Spaghetti", price: 230, time: "4:00pm", image: require("./spaghetti.jpg"), quantity: 1 },
    { id: 5, name: "Salad", price: 200, time: "4:00pm", image: require("./salad.jpg"), quantity: 1 },
  ];

  const updateQuantity = (id, delta, setCartItems, cartItems) => {
    setCartItems((prevItems) =>
      prevItems.map((item) =>
        item.id === id
          ? { ...item, quantity: Math.max(0, item.quantity + delta) }
          : item
      )
    );
  };

  const renderItem = ({ item }) => (
    <View style={styles.cartItem}>
      <Image source={item.image} style={styles.itemImage} />
      <View style={styles.itemDetails}>
        <Text style={styles.itemName}>{item.name}</Text>
        <Text style={styles.itemPrice}>{item.price}</Text>
      </View>
      <Text style={styles.itemTime}>{item.time}</Text>
      <View style={styles.quantityControls}>
        <TouchableOpacity
          style={styles.decrementButton}
          onPress={() => updateQuantity(item.id, -1, setCartItems, cartItems)}
        >
          <Text style={styles.buttonText}>-</Text>
        </TouchableOpacity>
        <Text>{item.quantity}</Text>
        <TouchableOpacity
          style={styles.incrementButton}
          onPress={() => updateQuantity(item.id, 1, setCartItems, cartItems)}
        >
          <Text style={styles.buttonText}>+</Text>
        </TouchableOpacity>
      </View>
    </View>
  );

  return (
    <View style={styles.container}>
      <View style={styles.header}>
        <Text style={styles.title}>Your Cart</Text>
      </View>

      <Text style={styles.sectionTitle}>Today</Text>
      <FlatList
        data={todayItems}
        renderItem={renderItem}
        keyExtractor={(item) => item.id.toString()}
      />

      <Text style={styles.sectionTitle}>Last Week</Text>
      <FlatList
        data={lastWeekItems}
        renderItem={renderItem}
        keyExtractor={(item) => item.id.toString()}
      />

      <TouchableOpacity style={styles.confirmButton}>
        <Text style={styles.confirmButtonText}>Confirm Order</Text>
      </TouchableOpacity>
    </View>
  );
};

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: "#f5f5f5",
    paddingHorizontal: 16,
  },
  header: {
    marginVertical: 20,
    alignItems: "center",
  },
  title: {
    fontSize: 24,
    fontWeight: "bold",
  },
  sectionTitle: {
    fontSize: 18,
    marginVertical: 10,
    fontWeight: "bold",
  },
  cartItem: {
    flexDirection: "row",
    alignItems: "center",
    backgroundColor: "#fff",
    padding: 10,
    marginVertical: 5,
    borderRadius: 10,
  },
  itemImage: {
    width: 50,
    height: 50,
    borderRadius: 10,
    marginRight: 10,
  },
  itemDetails: {
    flex: 1,
  },
  itemName: {
    fontSize: 16,
    fontWeight: "bold",
  },
  itemPrice: {
    fontSize: 14,
    color: "#888",
  },
  itemTime: {
    fontSize: 12,
    color: "#888",
    marginHorizontal: 10,
  },
  quantityControls: {
    flexDirection: "row",
    alignItems: "center",
  },
  decrementButton: {
    backgroundColor: "#ffcccc",
    padding: 5,
    borderRadius: 5,
  },
  incrementButton: {
    backgroundColor: "#ffcccc",
    padding: 5,
    borderRadius: 5,
  },
  buttonText: {
    fontSize: 16,
    color: "#fff",
  },
  confirmButton: {
    backgroundColor: "#ff4444",
    padding: 15,
    marginVertical: 20,
    alignItems: "center",
    borderRadius: 10,
  },
  confirmButtonText: {
    color: "#fff",
    fontSize: 18,
    fontWeight: "bold",
  },
});

export default Cart;
